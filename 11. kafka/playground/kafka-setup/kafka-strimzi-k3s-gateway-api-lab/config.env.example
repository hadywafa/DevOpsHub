# Copy to .lab.env and adjust when needed.
NAMESPACE=kafka-lab
KAFKA_NAME=lab-kafka

# Multipass/K3s networking.
# LOAD_BALANCER_IP must be an unused IP on the same L2 subnet as the K3s node.
# Example: node 10.10.10.20 -> choose an unused address such as 10.10.10.240.
LOAD_BALANCER_IP=10.10.10.240
BASE_DOMAIN=kafka.test

# Component versions.
STRIMZI_VERSION=1.1.0
ENVOY_GATEWAY_VERSION=v1.8.3
METALLB_CHART_VERSION=0.16.1

# Optional host file management. Set false to manage DNS yourself.
CONFIGURE_HOSTS=true

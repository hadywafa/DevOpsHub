# Copy to terraform.tfvars and adjust per environment.
# Better yet: keep one tfvars file per env (dev.tfvars, staging.tfvars,
# prod.tfvars) and select a matching backend key per env - see README.

region  = "eu-north-1"
env     = "dev"
project = "ai71demo"

vpc_cidr             = "10.30.0.0/16"
azs                  = ["eu-north-1a", "eu-north-1b", "eu-north-1c"]
public_subnet_cidrs  = ["10.30.0.0/24", "10.30.1.0/24", "10.30.2.0/24"]
private_subnet_cidrs = ["10.30.10.0/24", "10.30.11.0/24", "10.30.12.0/24"]

kubernetes_version  = "1.30"
node_instance_type  = "m6i.large"
node_desired        = 3
node_min            = 2
node_max            = 5

gpu_node_pool_enabled = false

dns_zone_name   = "platform.example.com"
create_dns_zone = true

# db_password is intentionally omitted here - export TF_VAR_db_password or
# inject it from your CI secret store instead.

tags = {
  owner = "platform-team"
}
